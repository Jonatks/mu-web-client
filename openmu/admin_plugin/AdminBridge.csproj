<Project Sdk="Microsoft.NET.Sdk">
  <!-- The admin bridge plugin, compiled against the assemblies of the OpenMU image it runs in. See readme.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>MUnique.OpenMU.MuAdminBridge</AssemblyName>
    <RootNamespace>MUnique.OpenMU</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OpenMuDir Condition="'$(OpenMuDir)' == ''">/openmu</OpenMuDir>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="$(OpenMuDir)/MUnique.OpenMU.*.dll" Private="false" />
    <Reference Include="$(OpenMuDir)/Nito.*.dll" Private="false" />
    <Using Include="System.ComponentModel.DataAnnotations" />
  </ItemGroup>
</Project>
